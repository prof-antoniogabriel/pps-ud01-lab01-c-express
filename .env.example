# Puerto en el que escuchará el servidor Node.js/Express.
# En este caso, la aplicación quedará disponible en el puerto 3000.
PORT=3000

# Nombre descriptivo de la aplicación.
# Puede utilizarse en mensajes, logs, respuestas de la API
# o cualquier otra parte del proyecto donde se quiera identificar el servicio.
APP_NAME=Avisos de Seguridad